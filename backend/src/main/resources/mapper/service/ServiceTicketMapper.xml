<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  人工工单 Mapper
  说明:手工 SQL 一律写在 XML,Java 接口只保留方法声明。
-->
<mapper namespace="com.insure.ai.modules.service.mapper.ServiceTicketMapper">

    <!--
      查询指定前缀下最大的工单号,用于生成当日流水
      不带逻辑删除条件:已删除的工单号仍占用唯一索引,不能重复分配
    -->
    <select id="selectMaxTicketNo" resultType="java.lang.String">
        SELECT MAX(ticket_no)
        FROM svc_ticket
        WHERE ticket_no LIKE CONCAT(#{prefix}, '%')
    </select>

</mapper>

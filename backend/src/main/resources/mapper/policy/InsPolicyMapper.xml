<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  保单 Mapper
  说明:手工 SQL 一律写在 XML,Java 接口只保留方法声明。
-->
<mapper namespace="com.insure.ai.modules.policy.mapper.InsPolicyMapper">

    <!-- 统计每个客户的保单数量(客户列表页使用) -->
    <select id="countGroupByCusUser" resultType="java.util.Map">
        SELECT cus_user_id AS cusUserId, COUNT(*) AS policyCount
        FROM ins_policy
        WHERE deleted = 0
        GROUP BY cus_user_id
    </select>

</mapper>

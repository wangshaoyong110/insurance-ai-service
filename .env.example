# 复制为 .env 后填写，docker compose 会自动读取
# 注意：.env 已在 .gitignore 中，切勿提交

# 对外访问端口
WEB_PORT=80

# ---------------- 数据库 ----------------
MYSQL_DATABASE=insurance_ai
MYSQL_ROOT_PASSWORD=change-me-strong-password

# ---------------- 后端安全 ----------------
# JWT 签名密钥：长度必须 >= 32 字节，可用 openssl rand -base64 48 生成
INSURE_JWT_SECRET=please-replace-with-48-bytes-random-string-xxxxxxxx

# API Key 加密主密钥（AES-256-GCM）
# 一旦配置就不要再改：改了之后数据库里已加密的 Key 将无法解密，需在后台重新录入
INSURE_CRYPTO_SECRET=please-replace-with-another-random-secret

# ---------------- 可选 ----------------
# 仅首次初始化模型配置时使用；配置好之后可在后台「系统管理-模型配置」里改
INSURE_DEEPSEEK_API_KEY=

# 内网交付建议设为 false，避免接口清单外泄
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

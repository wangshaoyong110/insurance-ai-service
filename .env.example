# 复制为 .env 后填写，docker compose 会自动读取
# 注意：.env 已在 .gitignore 中，切勿提交

# 对外访问端口
WEB_PORT=80

# ---------------- 数据库 ----------------
MYSQL_DATABASE=insurance_ai
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Redis 密码：Redis 只在 Docker 内网、不映射端口，但仍建议设密码
# 防止同宿主机上的其他容器横向访问（内网污染/多租户场景）
REDIS_PASSWORD=change-me-redis-password

# ---------------- 后端安全 ----------------
# JWT 签名密钥：长度必须 >= 32 字节，可用 openssl rand -base64 48 生成
INSURE_JWT_SECRET=please-replace-with-48-bytes-random-string-xxxxxxxx

# API Key 加密主密钥（国密 SM4-GCM，密钥由 PBKDF2-HMAC-SM3 派生）
# 一旦配置就不要再改：改了之后数据库里已加密的 Key 将无法解密，需在后台重新录入
INSURE_CRYPTO_SECRET=please-replace-with-another-random-secret

# ---------------- 短信验证码 ----------------
# 运营商尚未接入：mock=true 时只打日志、验证码随接口回显，便于演示
INSURE_SMS_MOCK=true
# 注册是否强制校验验证码（本地联调可临时置 false）
INSURE_SMS_VERIFY_REGISTER=true
# 防刷阈值：同 IP 小时/自然日上限、全站每日短信预算
INSURE_SMS_IP_HOURLY_LIMIT=20
INSURE_SMS_IP_DAILY_LIMIT=50
INSURE_SMS_GLOBAL_DAILY_LIMIT=1000
# 部署在 Nginx/网关后，需在 application.yml 的 insure.security.trusted-proxies
# 登记网关内网 IP 才会采信 X-Forwarded-For；留空（默认）即一律忽略，防止伪造 IP 绕过限流

# ---------------- 图形验证码 ----------------
# 登录/注册/发短信前都要校验;生产必须保持 enabled=true 且 debug=false
INSURE_CAPTCHA_ENABLED=true
# 演示模式会回显验证码明文,便于自动化联调;生产必须置 false
INSURE_CAPTCHA_DEBUG=true

# ---------------- 文件上传限额 ----------------
# 全局单文件硬上限(任何业务都不能突破)与分业务限额(与全局取小)
# bizType=avatar 头像 / kb 知识库 / chat 聊天图片视频 / common 其他
INSURE_UPLOAD_MAX_SIZE=50MB
INSURE_UPLOAD_AVATAR_LIMIT=2MB
INSURE_UPLOAD_KB_LIMIT=20MB
INSURE_UPLOAD_CHAT_IMAGE_LIMIT=10MB
INSURE_UPLOAD_CHAT_VIDEO_LIMIT=50MB
INSURE_UPLOAD_COMMON_LIMIT=20MB

# ---------------- 可选 ----------------
# 仅首次初始化模型配置时使用；配置好之后可在后台「系统管理-模型配置」里改
INSURE_DEEPSEEK_API_KEY=

# 公网/内网交付一律建议 false：接口清单会暴露全部路径与参数，是攻击者的地图
# （Nginx 配置里还有一道 404 拦截，两层都关更稳）
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

# ---------------- 运维端口映射(可选) ----------------
# MySQL/Redis 直连宿主机的端口。公网部署建议:改非标准端口 或 云安全组限源到自己的 IP
#MYSQL_HOST_PORT=3306
#REDIS_HOST_PORT=6379
